# 复制为 .env 后按需修改。.env 含口令与密钥，不入库。
#
# 本地开发和服务器上是**两份不同的 .env**，不要把服务器那份带回本地，
# 也不要把这里的示例值带上线。部署步骤见 docs/deploy.md。

# ── 数据库 ───────────────────────────────────────────────
# 本机直连 docker compose 起的 postgres（宿主机跑 next dev 时用）。
# 端口不是标准的 5432：Windows 的 Hyper-V 保留了 5376–6175 整段，绑不上。
DATABASE_URL="postgresql://keti:keti_dev_pw@localhost:15432/keticompass?schema=public"
# 若 app 也跑在 compose 里（`--profile full`），走服务名与容器内端口。
# 这一条不用自己写，docker-compose.yml 会用下面几个变量拼好注进容器：
# DATABASE_URL="postgresql://keti:keti_dev_pw@postgres:5432/keticompass?schema=public"

# docker-compose.yml 中 postgres 服务的初始化参数
POSTGRES_USER="keti"
# 这个值会被拼进 DATABASE_URL，**别用 @ : / ? # 这些字符**，会把连接串截断。
# 生成一个安全的：openssl rand -base64url 18
POSTGRES_PASSWORD="keti_dev_pw"
POSTGRES_DB="keticompass"
# 宿主机暴露的端口。Linux 服务器上可以改回 5432
POSTGRES_PORT="15432"

# ── 登录 ─────────────────────────────────────────────────
# 单人使用的口令，见 PRD 6。**上线前必须换掉**
APP_PASSCODE="change-me"
# 会话 cookie 的 HMAC 签名密钥，用 `openssl rand -base64 32` 生成。
# 换掉它等于让所有已登录的会话立即失效
APP_SESSION_SECRET="change-me"

# 可选的服务端绝对上传根目录；不设置时仍使用 ./data/uploads。
# E2E 会自行传入系统临时目录，绝不读取本地 .env 文件。
# UPLOAD_ROOT="/absolute/path/to/uploads"

# ── 会议录音转写（增量 3.3）────────────────────────────────
# 必须是仓库和 UPLOAD_ROOT 之外的绝对路径；目录权限应为 700，文件权限为 600。
# 临时音频不进附件备份，后续由“确认纪要后删除音频”的独立能力管理。
# AUDIO_TEMP_ROOT="/var/lib/teacher-desk-audio"
# 全部未删除录音的总量上限（默认 2GiB）
# AUDIO_QUOTA_BYTES="2147483648"
# 转写抢占租约；超时任务由维护入口恢复并重试（默认 30 分钟）
# TRANSCRIPTION_LEASE_MINUTES="30"
TENCENT_ASR_APP_ID=""
TENCENT_SECRET_ID=""
TENCENT_SECRET_KEY=""
# 独立于 APP_PASSCODE；生成：openssl rand -base64 32
MAINTENANCE_TOKEN=""
# 仅供自动化测试显式启用；生产不要设置为 fake
# TRANSCRIPTION_ADAPTER="fake"

# ── 会议纪要草稿（增量 3.4）────────────────────────────────
# OpenAI-compatible JSON 接口。三项全部留空时自动降级为手工纪要，不影响转写和确认。
MINUTES_API_BASE_URL=""
MINUTES_API_KEY=""
MINUTES_MODEL=""
# 仅供自动化测试显式启用；生产不要设置为 fake
# MINUTES_ADAPTER="fake"

# ── 备课系统（增量 3.6 教案回流）───────────────────────────
# 独立部署的另一套系统，教学页只做两件事：把人送过去，和收回来的教案。
# 地址必须是完整 http(s) URL——它最终进 <a href>，写成 `javascript:` 就是
# 自己给自己开的 XSS，所以 lib/integrations.ts 会校验协议，不合法一律当没配。
TEACHING_APP_URL=""
# 教案回流接口的服务令牌，**与 APP_PASSCODE 分离、独立轮换**：
# 备课系统被攻破不应该等于本平台被攻破。生成：openssl rand -base64 32
# 未配置时 /api/teaching/import 一律拒绝（fail-closed，不是放行）
TEACHING_IMPORT_TOKEN=""

# ── 站点与 HTTPS（`--profile full` 才用得上）─────────────
# Caddy 的站点地址。线上填**已备案**的域名，Caddy 自动向 Let's Encrypt 申请证书；
# 本地演练填 localhost，Caddy 自动改用内置 CA 签自签证书（浏览器会警告一次）
APP_DOMAIN="localhost"
# 对外端口。线上保持 80/443 不要改——80 是 Let's Encrypt 的 HTTP-01 校验要用的。
# 本地这两个端口被占时才改
# HTTP_PORT="80"
# HTTPS_PORT="443"

# ── 时区 ─────────────────────────────────────────────────
# 全平台只有这一套时区假设：**进程时区 = 用户所在时区**。
# lib/date.ts 的 todayAsDateOnly() 按进程本地时区判断「今天是几号」，
# 留 UTC 的话东八区每天 00:00–08:00 之间「今天」会算成昨天，
# 倒计时、逾期判定、周期任务生成全部差一天。
# 镜像里已经写死东八区，这里给出来只是为了能不重新构建就改
# TZ="Asia/Shanghai"

# ── 备份（scripts/backup.sh 读，服务器上才用）───────────
# BACKUP_DIR="/opt/keticompass-backups"
# KEEP="14"

# ── AI（Phase 5 才需要）─────────────────────────────────
# AI_PROVIDER="deepseek"
# AI_API_KEY=""
# AI_BASE_URL=""
