# 演示环境配置 —— 复制为 .env.demo 后使用。
#
# 这份和 .env 是**两份完全独立的配置**。它只指向演示库，用于截图和录屏。
# 演示流程会 TRUNCATE 目标库，所以库名必须含 "demo"：
# scripts/demo.mjs 和 scripts/seed-demo.ts 各有一道检查，不含就拒绝运行。

# ── 演示库 ───────────────────────────────────────────────
# 和真实库同一个 postgres 实例，只是换个库名。口令与 .env 里的一致。
DATABASE_URL="postgresql://keti:keti_dev_pw@localhost:15432/keticompass_demo?schema=public"

# ── 演示附件目录 ─────────────────────────────────────────
# 必须是绝对路径，且路径里要含 demo——种子脚本据此判断能不能落盘，
# 不含就只建数据库记录、跳过写文件，免得把演示 PDF 混进真实的 data/uploads。
# Windows 用正斜杠，例如 D:/teacher-desk/data/uploads-demo
UPLOAD_ROOT=""

# ── 登录 ─────────────────────────────────────────────────
# 演示环境用个好记的就行，反正库里全是虚构数据。
APP_PASSCODE="demo1234"
APP_SESSION_SECRET="demo-session-secret-not-for-production"

# ── 时区 ─────────────────────────────────────────────────
# 和生产保持一致，否则倒计时和「今天」会差一天，截图上的天数就不对了。
TZ="Asia/Shanghai"

# ── 刻意不配的 ───────────────────────────────────────────
# 转写、纪要、教案回流的密钥一律留空：演示不该往云端发任何东西。
# 留空时系统自动降级为手工纪要，不影响截图。
TENCENT_ASR_APP_ID=""
TENCENT_SECRET_ID=""
TENCENT_SECRET_KEY=""
MINUTES_API_BASE_URL=""
MINUTES_API_KEY=""
MINUTES_MODEL=""
TEACHING_APP_URL=""
TEACHING_IMPORT_TOKEN=""
