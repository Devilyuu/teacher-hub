{
  "name": "teacher-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:cleanup-drill": "node scripts/run-e2e.mjs --cleanup-drill",
    "test:e2e:signal-drill": "node scripts/verify-e2e-signal-cleanup.mjs",
    "verify:build-trace": "node scripts/verify-build-trace.mjs",
    "verify:backup-safety": "node scripts/verify-backup-safety.mjs",
    "verify:compose-security": "node scripts/verify-compose-security.mjs",
    "verify:passcode-script": "node scripts/verify-passcode-change-script.mjs",
    "verify:runtime-image": "node scripts/verify-runtime-image.mjs",
    "verify:server-actions-auth": "node scripts/verify-server-actions-auth.mjs",
    "verify:export-run": "tsx --conditions=react-server scripts/verify-export-run.ts",
    "verify:project-outcomes": "tsx --conditions=react-server scripts/verify-project-outcomes.ts",
    "verify:meeting-recording": "tsx --conditions=react-server scripts/verify-meeting-recording.ts",
    "verify:requirement-materials": "tsx --conditions=react-server scripts/verify-requirement-materials.ts",
    "verify:personal-documents": "tsx --conditions=react-server scripts/verify-personal-documents.ts",
    "verify:material-zip": "tsx --conditions=react-server scripts/verify-material-zip.ts",
    "verify:closeout-docx": "tsx --conditions=react-server scripts/verify-closeout-docx.ts",
    "verify:full-backup": "tsx --conditions=react-server scripts/verify-full-backup.ts",
    "verify:teaching-import": "tsx --conditions=react-server scripts/verify-teaching-import.ts",
    "verify:timetable": "tsx --conditions=react-server scripts/verify-timetable.ts",
    "smoke:transcription": "tsx --conditions=react-server scripts/smoke-transcription.ts",
    "smoke:minutes": "tsx --conditions=react-server scripts/smoke-minutes.ts",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "demo:create-db": "node scripts/demo.mjs create-db",
    "demo:reset": "node scripts/demo.mjs reset",
    "demo:seed": "node scripts/demo.mjs seed",
    "demo:dev": "node scripts/demo.mjs dev",
    "import:perf-rules": "tsx scripts/import-perf-rules.ts",
    "import:promotion-rules": "tsx scripts/import-promotion-rules.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.26.0",
    "music-metadata": "^11.14.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
